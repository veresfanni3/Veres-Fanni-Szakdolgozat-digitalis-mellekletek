        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Point.ByCoordinates@double,double,double",
      "Replication": "Auto",
      "Description": "Form a Point given 3 cartesian coordinates\n\nPoint.ByCoordinates (x: double = 0, y: double = 0, z: double = 0): Point"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "9169eec173874586a38eb8822db8449f",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "0610e86424034d65a201a7f706953525",
          "Name": "Nyomvonal",
          "Description": "Nyomvonal",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e0b3121a831c49d2ac5857b21cfc39d7",
          "Name": "PontLista",
          "Description": "PontLista",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5bfbcdf0bf534aba920c90a89b8d666e",
          "Name": "StationOffsetData",
          "Description": "StationOffsetData = Autodesk.Civil.DynamoNodes.Alignment.StationOffsetByPoint(Nyomvonal, PontLista)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "168d7ec577c8439e8111826c93ebe0da",
          "Name": "Szelveny",
          "Description": "Szelveny = DesignScript.Builtin.Dictionary.ValueAtKey(StationOffsetData, \"Station\")",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1abeb26b4bf94c059e025566542ea2f0",
          "Name": "idx",
          "Description": "idx = DSCore.List.IndexOf(Szelveny, null)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "63337cecf158471295b93a1ee994202a",
          "Name": "Szelveny_Jav",
          "Description": "Szelveny_Jav = DSCore.List.RemoveItemAtIndex(Szelveny, idx)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c261219b02c641c2994156d1dda001bf",
          "Name": "Pontlista_Jav",
          "Description": "Pontlista_Jav = DSCore.List.RemoveItemAtIndex(PontLista, idx)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "efdf8a0f35fb44dd8fb0f26d2e26698d",
          "Name": "Feltetel",
          "Description": "Feltetel = DSCore.Object.IsNull(idx)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "00c353c5b4db4fbe8e14097e29272918",
          "Name": "a",
          "Description": "a = DSCore.List.SortByKey(Pontlista_Jav, Szelveny_Jav)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3f6e62b346d240b09f1da4d52ffecff5",
          "Name": "b",
          "Description": "b = DSCore.List.SortByKey(PontLista, Szelveny)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "06140a9d72ee4a7eb579344be5a28ac5",
          "Name": "DataSorting",
          "Description": "DataSorting = ((Feltetel ? b : a))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c4f2667215e0457ba4a7e9c92676147f",
          "Name": "SortedPontLista0",
          "Description": "SortedPontLista0 = DesignScript.Builtin.Dictionary.ValueAtKey(DataSorting, \"sortedList\")",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e1dd2e06632c400eb0b37f0d04fa0c38",
          "Name": "SortedPontLista1",
          "Description": "SortedPontLista1 = Autodesk.DesignScript.Geometry.Point.PruneDuplicates(SortedPontLista0, 0.0005)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2096f61365a547a297af4b30abc7d07e",
          "Name": "n",
          "Description": "n = DSCore.List.Count(SortedPontLista1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "db582562e50240679fd7507182b4a9e4",
          "Name": "Vonalak0",
          "Description": "Vonalak0 = Autodesk.DesignScript.Geometry.Line.ByStartPointEndPoint(DesignScript.Builtin.Get.ValueAtIndex(SortedPontLista1, 0..n - 2), DesignScript.Builtin.Get.ValueAtIndex(SortedPontLista1, 1..n - 1))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ff62b580ff524074abfc619f753a1415",
          "Name": "Vonalak1",
          "Description": "Vonalak1 = DSCore.List.Clean(Vonalak0, false)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d5f003202ede42d38573be95ea7695c1",
          "Name": "Vonallanc",
          "Description": "Vonallanc = Autodesk.DesignScript.Geometry.PolyCurve.ByJoinedCurves(Vonalak1, 0.001, false, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Function\n//\n//  ****************************************\n//\n//   result = Feltetel ? HaIgaz : HaHamis;\n//\n//  ****************************************\n//\n// Nyomvonalra illesztés\nStationOffsetData = Autodesk.Civil.DynamoNodes.Alignment.StationOffsetByPoint(Nyomvonal,PontLista);\nSzelveny = DesignScript.Builtin.Dictionary.ValueAtKey(StationOffsetData,\"Station\");\n\n// Nyomvonalra nem illeszkedő pontok kiszűrése\nidx = DSCore.List.IndexOf(Szelveny, null);\nSzelveny_Jav = DSCore.List.RemoveItemAtIndex(Szelveny,idx);\nPontlista_Jav = DSCore.List.RemoveItemAtIndex(PontLista,idx);\n\n// Condition\nFeltetel =DSCore.Object.IsNull(idx);\na = DSCore.List.SortByKey(Pontlista_Jav,Szelveny_Jav);\nb = DSCore.List.SortByKey(PontLista,Szelveny);\nDataSorting = Feltetel ? b : a;\n\n// Pontok összekötése\n//DataSorting = DSCore.List.SortByKey(Pontlista_Jav,Szelveny_Jav);\nSortedPontLista0 = DesignScript.Builtin.Dictionary.ValueAtKey(DataSorting,\"sortedList\");\nSortedPontLista1 = Autodesk.DesignScript.Geometry.Point.PruneDuplicates(SortedPontLista0,0.0005);\n\nn = DSCore.List.Count(SortedPontLista1);\nVonalak0 = Autodesk.DesignScript.Geometry.Line.ByStartPointEndPoint(SortedPontLista1[0.. n-2],SortedPontLista1[1.. n-1]);\nVonalak1 =DSCore.List.Clean(Vonalak0,false);\nVonallanc = Autodesk.DesignScript.Geometry.PolyCurve.ByJoinedCurves(Vonalak1, 0.001, false, 0);"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "d493e98d300a4f3babf60c18861b41db",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "14187ea94ccc417497416eed5cf84d1f",
          "Name": "VonalNev",
          "Description": "VonalNev",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "02c6dfe3de944b648da3f26b64591a67",
          "Name": "AktualKOD",
          "Description": "AktualKOD",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b5df961581394179a3c7e75a47913bf1",
          "Name": "function",
          "Description": "((\"VF_SZG_GEOD_\" + VonalNev) + \"_\") + AktualKOD",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// FóliaNev\n\"VF_SZG_GEOD_\" + VonalNev + \"_\" + AktualKOD;"
    },
