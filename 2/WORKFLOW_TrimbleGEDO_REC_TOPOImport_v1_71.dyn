    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "f6c3d46cde13432595c3c773a633d2c1",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "2bb9328ebc1d4d838bccab2eacec85d2",
          "Name": "Nyomvonal",
          "Description": "Nyomvonal",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d0f9aca5ff944bab8fd1c37fc649bece",
          "Name": "PontLista",
          "Description": "PontLista",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d9a8ce5c6a7c485fa42d7ba9d2f81e49",
          "Name": "StationOffsetData",
          "Description": "StationOffsetData = Autodesk.Civil.DynamoNodes.Alignment.StationOffsetByPoint(Nyomvonal, PontLista)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "67055e705eb84562bc78c833d170f75c",
          "Name": "Szelveny",
          "Description": "Szelveny = DesignScript.Builtin.Dictionary.ValueAtKey(StationOffsetData, \"Station\")",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1913e2af6bca4ddb93d58d402d883d4d",
          "Name": "idx",
          "Description": "idx = DSCore.List.IndexOf(Szelveny, null)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ef286225cf79499fbc14d040cc1ec2ff",
          "Name": "Szelveny_Jav",
          "Description": "Szelveny_Jav = DSCore.List.RemoveItemAtIndex(Szelveny, idx)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8041fd72cb814f1eaa0e2397ad460607",
          "Name": "Pontlista_Jav",
          "Description": "Pontlista_Jav = DSCore.List.RemoveItemAtIndex(PontLista, idx)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1446bc1727554789867e7a75d10bac11",
          "Name": "Feltetel",
          "Description": "Feltetel = DSCore.Object.IsNull(idx)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0a6c53c6b9504a00aafc21bfdf83f372",
          "Name": "a",
          "Description": "a = DSCore.List.SortByKey(Pontlista_Jav, Szelveny_Jav)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "fd601d424d31427594d5d2fe4ebbdc1b",
          "Name": "b",
          "Description": "b = DSCore.List.SortByKey(PontLista, Szelveny)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4157622f24fd4843ae5fd189346bdb65",
          "Name": "DataSorting",
          "Description": "DataSorting = ((Feltetel ? b : a))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3eab84effac74085929d6aa4510814fc",
          "Name": "SortedPontLista0",
          "Description": "SortedPontLista0 = DesignScript.Builtin.Dictionary.ValueAtKey(DataSorting, \"sortedList\")",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "149d3993e15a4fb8aee76ee50b53cd07",
          "Name": "SortedPontLista1",
          "Description": "SortedPontLista1 = Autodesk.DesignScript.Geometry.Point.PruneDuplicates(SortedPontLista0, 0.0005)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e6aca77ba1864fa5ac6c7590f3d54e86",
          "Name": "n",
          "Description": "n = DSCore.List.Count(SortedPontLista1)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "545b3bb82f674bb6921cbafb7c9718f3",
          "Name": "Vonalak0",
          "Description": "Vonalak0 = Autodesk.DesignScript.Geometry.Line.ByStartPointEndPoint(DesignScript.Builtin.Get.ValueAtIndex(SortedPontLista1, 0..n - 2), DesignScript.Builtin.Get.ValueAtIndex(SortedPontLista1, 1..n - 1))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "98c37046dc824aa182e5b06de54d11bc",
          "Name": "Vonallanc",
          "Description": "Vonallanc = Autodesk.DesignScript.Geometry.PolyCurve.ByJoinedCurves(Vonalak0, 0.001, false, 0)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Function\n//\n//  ****************************************\n//\n//   result = Feltetel ? HaIgaz : HaHamis;\n//\n//  ****************************************\n//\n// Nyomvonalra illesztés\nStationOffsetData = Autodesk.Civil.DynamoNodes.Alignment.StationOffsetByPoint(Nyomvonal,PontLista);\nSzelveny = DesignScript.Builtin.Dictionary.ValueAtKey(StationOffsetData,\"Station\");\n\n// Nyomvonalra nem illeszkedő pontok kiszűrése\nidx = DSCore.List.IndexOf(Szelveny, null);\nSzelveny_Jav = DSCore.List.RemoveItemAtIndex(Szelveny,idx);\nPontlista_Jav = DSCore.List.RemoveItemAtIndex(PontLista,idx);\n\n// Condition\nFeltetel =DSCore.Object.IsNull(idx);\na = DSCore.List.SortByKey(Pontlista_Jav,Szelveny_Jav);\nb = DSCore.List.SortByKey(PontLista,Szelveny);\nDataSorting = Feltetel ? b : a;\n\n// Pontok összekötése\n//DataSorting = DSCore.List.SortByKey(Pontlista_Jav,Szelveny_Jav);\nSortedPontLista0 = DesignScript.Builtin.Dictionary.ValueAtKey(DataSorting,\"sortedList\");\nSortedPontLista1 = Autodesk.DesignScript.Geometry.Point.PruneDuplicates(SortedPontLista0,0.0005);\n\nn = DSCore.List.Count(SortedPontLista1);\nVonalak0 = Autodesk.DesignScript.Geometry.Line.ByStartPointEndPoint(SortedPontLista1[0.. n-2],SortedPontLista1[1.. n-1]);\nVonallanc = Autodesk.DesignScript.Geometry.PolyCurve.ByJoinedCurves(Vonalak0, 0.001, false, 0);"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "d6b20432af0e41dd8803ce2f22e3b7ec",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "7e60853c817c43efbfb239d8f1104681",
          "Name": "layer",
          "Description": "Autodesk.AutoCAD.DynamoNodes.Layer",
